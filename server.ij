require("dotenv").config();

const express = require("express");

const app = express();

const PORT = process.env.PORT || 3000;

const SPTRANS_TOKEN = process.env.SPTRANS_TOKEN;

const SPTRANS_URL =
    "https://api.olhovivo.sptrans.com.br/v2.1";


app.use(express.json());

app.use(express.static("."));


/* =====================================================
   AUTENTICAÇÃO SPTRANS
===================================================== */

let cookieSPTrans = null;


async function autenticarSPTrans() {

    if (!SPTRANS_TOKEN) {

        throw new Error(
            "SPTRANS_TOKEN não foi configurado."
        );

    }


    const resposta = await fetch(

        SPTRANS_URL +
        "/Login/Autenticar?token=" +
        encodeURIComponent(
            SPTRANS_TOKEN
        ),

        {
            method: "POST"
        }

    );


    const cookies =
        resposta.headers.get(
            "set-cookie"
        );


    if (cookies) {

        cookieSPTrans =
            cookies
            .split(";")[0];

    }


    const resultado =
        await resposta.text();


    if (resultado !== "true") {

        throw new Error(
            "Falha na autenticação da SPTrans."
        );

    }


    return true;

}


/* =====================================================
   GARANTIR AUTENTICAÇÃO
===================================================== */

async function garantirAutenticacao() {

    if (!cookieSPTrans) {

        await autenticarSPTrans();

    }

}


/* =====================================================
   CHAMAR API SPTRANS
===================================================== */

async function sptransFetch(
    endpoint
) {


    await garantirAutenticacao();


    let resposta = await fetch(

        SPTRANS_URL + endpoint,

        {

            headers: {

                Cookie:
                cookieSPTrans

            }

        }

    );


    /*
       Caso a sessão tenha expirado,
       autentica novamente.
    */

    if (resposta.status === 401) {

        cookieSPTrans = null;

        await autenticarSPTrans();


        resposta = await fetch(

            SPTRANS_URL + endpoint,

            {

                headers: {

                    Cookie:
                    cookieSPTrans

                }

            }

        );

    }


    if (!resposta.ok) {

        throw new Error(
            "Erro na API SPTrans: " +
            resposta.status
        );

    }


    return resposta.json();

}


/* =====================================================
   DISTÂNCIA
===================================================== */

function distancia(

    lat1,
    lon1,
    lat2,
    lon2

) {

    const R = 6371000;


    const dLat =
        (lat2 - lat1) *
        Math.PI / 180;


    const dLon =
        (lon2 - lon1) *
        Math.PI / 180;


    const a =

        Math.sin(dLat / 2) *
        Math.sin(dLat / 2)

        +

        Math.cos(
            lat1 * Math.PI / 180
        )

        *

        Math.cos(
            lat2 * Math.PI / 180
        )

        *

        Math.sin(dLon / 2) *
        Math.sin(dLon / 2);


    const c =
        2 *
        Math.atan2(
            Math.sqrt(a),
            Math.sqrt(1 - a)
        );


    return R * c;

}


/* =====================================================
   PONTOS PRÓXIMOS
===================================================== */

app.get(
    "/api/pontos",
    async (req, res) => {

        try {

            const lat =
                Number(req.query.lat);

            const lon =
                Number(req.query.lon);


            if (
                !Number.isFinite(lat) ||
                !Number.isFinite(lon)
            ) {

                return res.status(400).json({

                    erro:
                    "Latitude e longitude inválidas."

                });

            }


            /*
               Buscamos pontos de ônibus
               próximos usando OpenStreetMap.

               Depois usamos a SPTrans para
               consultar as previsões quando
               houver correspondência.
            */

            const query = `

            [out:json];

            (
                node[
                    highway=bus_stop
                ](
                    around:700,
                    ${lat},
                    ${lon}
                );

                node[
                    public_transport=platform
                ](
                    around:700,
                    ${lat},
                    ${lon}
                );
            );

            out body;

            `;


            const respostaOSM =
                await fetch(

                    "https://overpass-api.de/api/interpreter",

                    {

                        method: "POST",

                        body: query

                    }

                );


            const dadosOSM =
                await respostaOSM.json();


            const pontos =
                dadosOSM.elements
                .map(ponto => {

                    const d =
                        distancia(

                            lat,
                            lon,

                            ponto.lat,
                            ponto.lon

                        );


                    return {

                        id:
                        ponto.id,

                        nome:
                        ponto.tags?.name ||
                        "Ponto de ônibus",

                        lat:
                        ponto.lat,

                        lon:
                        ponto.lon,

                        distancia:
                        Math.round(d)

                    };

                })

                .filter(
                    ponto =>
                    ponto.distancia <= 700
                )

                .sort(
                    (a, b) =>
                    a.distancia -
                    b.distancia
                );


            /*
               Limita a quantidade para
               não sobrecarregar as APIs.
            */

            const pontosLimitados =
                pontos.slice(0, 12);


            /*
               Tentamos localizar cada ponto
               na base da SPTrans.

               A busca é pelo nome do ponto.
            */

            const resultado = [];


            for (
                const ponto
                of pontosLimitados
            ) {


                let previsao = null;


                try {

                    const busca =
                        await sptransFetch(

                            "/Parada/Buscar?termosBusca=" +

                            encodeURIComponent(
                                ponto.nome
                            )

                        );


                    if (
                        Array.isArray(busca) &&
                        busca.length > 0
                    ) {


                        /*
                           Escolhe a parada SPTrans
                           mais próxima.
                        */

                        let melhor =
                            null;

                        let menor =
                            Infinity;


                        for (
                            const parada
                            of busca
                        ) {

                            const d =
                                distancia(

                                    ponto.lat,
                                    ponto.lon,

                                    Number(
                                        parada.py ??
                                        parada.Latitude
                                    ),

                                    Number(
                                        parada.px ??
                                        parada.Longitude
                                    )

                                );


                            if (
                                d < menor
                            ) {

                                menor = d;

                                melhor =
                                    parada;

                            }

                        }


                        /*
                           Só aceita uma
                           correspondência
                           geograficamente próxima.
                        */

                        if (
                            melhor &&
                            menor <= 250
                        ) {

                            const codigo =
                                melhor.cp ??
                                melhor.CodigoParada;


                            try {

                                previsao =
                                    await sptransFetch(

                                        "/Previsao/Parada?codigoParada=" +
                                        codigo

                                    );

                            }

                            catch (erro) {

                                console.log(
                                    "Sem previsão:",
                                    ponto.nome
                                );

                            }

                        }

                    }

                }

                catch (erro) {

                    console.log(
                        "Não foi possível cruzar ponto:",
                        ponto.nome
                    );

                }


                resultado.push({

                    ...ponto,

                    previsao:
                    previsao

                });

            }


            res.json({

                raio: 700,

                quantidade:
                resultado.length,

                pontos:
                resultado

            });


        }

        catch (erro) {

            console.error(erro);


            res.status(500).json({

                erro:
                "Não foi possível carregar os pontos."

            });

        }

    }
);


/* =====================================================
   FEEDBACK
===================================================== */

const feedbacks = [];


app.post(
    "/api/feedback",
    (req, res) => {


        const {

            linha,
            nota,
            categoria,
            comentario

        } = req.body;


        if (!linha) {

            return res.status(400).json({

                erro:
                "Informe a linha."

            });

        }


        const avaliacao = {

            id:
            Date.now(),

            linha:
            String(linha),

            nota:
            Math.max(
                1,
                Math.min(
                    5,
                    Number(nota) || 1
                )
            ),

            categoria:
            String(
                categoria ||
                "Geral"
            ),

            comentario:
            String(
                comentario ||
                ""
            ),

            data:
            new Date().toISOString()

        };


        feedbacks.push(
            avaliacao
        );


        res.json({

            sucesso:
            true,

            feedback:
            avaliacao

        });

    }
);


/* =====================================================
   BUSCAR FEEDBACK DE UMA LINHA
===================================================== */

app.get(
    "/api/feedback/:linha",
    (req, res) => {


        const linha =
            req.params.linha;


        const resultados =
            feedbacks.filter(

                item =>
                item.linha === linha

            );


        let media = 0;


        if (
            resultados.length > 0
        ) {

            media =

                resultados.reduce(

                    (
                        total,
                        item
                    ) =>
                    total + item.nota,

                    0

                )

                /

                resultados.length;

        }


        res.json({

            linha:

            linha,

            quantidade:

            resultados.length,

            media:

            Number(
                media.toFixed(1)
            ),

            feedbacks:

            resultados

        });

    }
);


/* =====================================================
   SERVIDOR
===================================================== */

app.listen(
    PORT,
    () => {

        console.log(
            `BusReview rodando na porta ${PORT}`
        );

    }
);
