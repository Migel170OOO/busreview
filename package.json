const express = require("express");
const path = require("path");

const app = express();

const PORT = process.env.PORT || 3000;

const SPTRANS_TOKEN = process.env.SPTRANS_TOKEN;

const SPTRANS_URL =
    "https://api.olhovivo.sptrans.com.br/v2.1";


// ==========================================
// VERIFICAR TOKEN
// ==========================================

if (!SPTRANS_TOKEN) {

    console.error(
        "ERRO: SPTRANS_TOKEN não foi configurado."
    );

}


// ==========================================
// FUNÇÃO DE AUTENTICAÇÃO
// ==========================================

async function autenticarSPTrans() {

    const resposta = await fetch(
        `${SPTRANS_URL}/Login/Autenticar?token=${encodeURIComponent(SPTRANS_TOKEN)}`,
        {
            method: "POST"
        }
    );


    if (!resposta.ok) {

        throw new Error(
            `Erro HTTP na autenticação: ${resposta.status}`
        );

    }


    const autenticado =
        await resposta.json();


    if (autenticado !== true) {

        throw new Error(
            "Token da SPTrans inválido."
        );

    }


    return true;

}


// ==========================================
// AUTENTICAR
// ==========================================

async function requisicaoSPTrans(
    endpoint
) {

    await autenticarSPTrans();


    const resposta =
        await fetch(
            `${SPTRANS_URL}${endpoint}`
        );


    if (!resposta.ok) {

        throw new Error(
            `SPTrans respondeu ${resposta.status}`
        );

    }


    return await resposta.json();

}


// ==========================================
// PARADAS
// ==========================================
//
// OBS:
// A API oficial da SPTrans permite buscar
// paradas por nome/endereço.
//
// Para a primeira versão, fazemos uma busca
// usando termos relacionados à localização.
//
// A busca geográfica completa dos pontos
// pode ser melhorada depois usando GTFS.
//
// ==========================================

app.get(
    "/api/paradas",
    async (req, res) => {

        try {

            const lat =
                Number(req.query.lat);

            const lon =
                Number(req.query.lon);


            if (
                !Number.isFinite(lat) ||
                !Number.isFinite(lon)
            ) {

                return res
                    .status(400)
                    .json({
                        error:
                            "Latitude ou longitude inválida."
                    });

            }


            /*
             * A API Olho Vivo não possui, na
             * documentação consultada, um endpoint
             * de busca de todas as paradas por
             * latitude/longitude.
             *
             * Por isso, esta versão usa a busca
             * textual da SPTrans.
             *
             * Para o mapa de 2 km, a solução ideal
             * será integrar o GTFS da SPTrans ou
             * manter um índice local das paradas.
             */


            const termos =
                "São Paulo";


            const dados =
                await requisicaoSPTrans(
                    `/Parada/Buscar?termosBusca=${encodeURIComponent(termos)}`
                );


            /*
             * Mantém apenas resultados que tenham
             * coordenadas válidas.
             */

            const resultado =
                dados.filter(
                    parada =>
                        Number.isFinite(
                            Number(
                                parada.py ??
                                parada.Latitude
                            )
                        ) &&
                        Number.isFinite(
                            Number(
                                parada.px ??
                                parada.Longitude
                            )
                        )
                );


            res.json(
                resultado
            );

        }
        catch (erro) {

            console.error(
                erro
            );


            res
                .status(500)
                .json({
                    error:
                        erro.message
                });

        }

    }
);


// ==========================================
// PREVISÃO DE PARADA
// ==========================================

app.get(
    "/api/previsao/:codigoParada",
    async (req, res) => {

        try {

            const codigoParada =
                Number(
                    req.params.codigoParada
                );


            if (
                !Number.isInteger(
                    codigoParada
                )
            ) {

                return res
                    .status(400)
                    .json({
                        error:
                            "Código da parada inválido."
                    });

            }


            const dados =
                await requisicaoSPTrans(
                    `/Previsao/Parada?codigoParada=${codigoParada}`
                );


            res.json(
                dados
            );

        }
        catch (erro) {

            console.error(
                erro
            );


            res
                .status(500)
                .json({
                    error:
                        erro.message
                });

        }

    }
);


// ==========================================
// SERVIR O INDEX.HTML
// ==========================================

app.use(
    express.static(
        path.join(
            __dirname
        )
    )
);


// ==========================================
// INICIAR SERVIDOR
// ==========================================

app.listen(
    PORT,
    () => {

        console.log(
            `BusReview rodando em http://localhost:${PORT}`
        );

    }
);
